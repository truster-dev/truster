{
  "$schema": "https://truster.dev/schema/v3/config.schema.json",

  // Core settings
  "issuer_url": "https://auth.example.com",
  "http_listen_addr": "127.0.0.1:8080",
  "signing_algorithm": "RS256",

  // Secrets configuration
  "secrets": {
    "provider": "aws-secrets-manager",
    "aws_region": "us-west-2",
    "signing_key_name": "truster-signing-key",
    // 64-character hex master key generated with: openssl rand -hex 32
    "encryption_key_name": "truster-encryption-key",
  },

  "state_database": {
    "driver": "sqlite",
    "path": "/var/lib/truster/truster-state.db",
  },

  // Upstream connector
  "user_login_connectors": {
    "github": {
      "type": "github",
      "display_name": "GitHub",
      "credentials_secret": "truster-github-credentials",
      "scopes": ["user:email"],

      // Optional: for GitHub Enterprise
      "github": {
        "hostname": "github.com",
      },
    },
  },

  "static_policy": {
    // Default redirect URIs
    "default_redirect_uris": ["http://localhost:8000"],

    // User group mappings
    "user_group_mappings": {
      "prod-groups": {
        "alice@example.com": ["admins", "developers"],
        "bob@example.com": ["readonly"],
      },
    },

    // OIDC clients
    "clients": {
      "kubelogin-prod": {
        "user_group_mapping": "prod-groups",
      },
    },
  },

  // Optional: Token TTL in seconds (default: 3600 = 1 hour)
  // "access_token_ttl": "15m",
  // "id_token_ttl": "15m",
}
