{
  "$schema": "https://truster.dev/schema/v3/config.schema.json",

  // Core settings
  "issuer_url": "https://auth.example.com",
  "http_listen_addr": "127.0.0.1:8080",
  "signing_algorithm": "RS256",

  // Secrets configuration
  "secrets": {
    "provider": "aws-secrets-manager", // "aws-secrets-manager", "aws-parameter-store", "google-secret-manager", "azure", or "env" for local dev
    "aws_region": "us-west-2",
    "signing_key_name": "truster-signing-key",
  },

  "state_database": {
    "driver": "sqlite",
    "path": "/var/lib/truster/truster-state.db",
  },

  // Upstream connector
  "user_login_connectors": {
    "google": {
      "type": "google",
      "display_name": "Google",
      "credentials_secret": "truster-google-credentials",
      "scopes": ["openid", "email", "profile"],

      // Optional: hint a Google Workspace domain in Google's account chooser
      "google": {
        "hd": "example.com",
      },
    },
  },

  "static_policy": {
    // Default redirect URIs (used if not specified per client)
    "default_redirect_uris": ["http://localhost:8000"],

    // User group mappings (email → groups)
    "user_group_mappings": {
      "prod-groups": {
        "alice@example.com": ["prod-admins", "devs"],
        "bob@example.com": ["prod-readonly"],
      },
      "dev-groups": {
        "alice@example.com": ["dev-admins"],
        "charlie@example.com": ["developers"],
      },
    },

    // OIDC clients (key is the client_id)
    "clients": {
      "kubelogin-prod": {
        "redirect_uris": ["http://localhost:8000"],
        "user_group_mapping": "prod-groups",
        // Optional: override require_user_groups_from_policy per-client
        // "require_user_groups_from_policy": false
      },
      "kubelogin-dev": {
        "user_group_mapping": "dev-groups",
      },
    },

    // Optional: Require users to have groups (default: true)
    // Set to false to allow authentication without groups
    // "require_user_groups_from_policy": true,
  },

  // Optional token lifetimes.
  // "access_token_ttl": "15m",
  // "id_token_ttl": "15m",
}
