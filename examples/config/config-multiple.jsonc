{
  "$schema": "https://truster.dev/schema/v3/config.schema.json",

  "issuer_url": "https://auth.example.com",
  "http_listen_addr": "127.0.0.1:8080",

  "secrets": {
    "provider": "env",
    "signing_key_name": "TRUSTER_SIGNING_KEY",
  },

  "state_database": {
    "driver": "sqlite",
    "path": "/var/lib/truster/truster-state.db",
  },

  "user_login_connectors": {
    "company-google": {
      "type": "google",
      "display_name": "Company Google",
      "order": 10,
      "credentials_secret": "TRUSTER_GOOGLE_CREDENTIALS",
    },
    "engineering-dex": {
      "type": "generic",
      "display_name": "Engineering Dex",
      "order": 20,
      "credentials_secret": "TRUSTER_DEX_CREDENTIALS",
      "generic": {
        "authorization_url": "https://dex.example.com/auth",
        "token_url": "https://dex.example.com/token",
        "userinfo_url": "https://dex.example.com/userinfo",
        "subject_field": "sub",
      },
    },
    "email": {
      "type": "email",
      "display_name": "Email code",
      "order": 30,
    },
  },

  "email": {
    "verification_mode": "provider",
    "otp_secret_name": "TRUSTER_OTP_SECRET",
    "otp_ttl": "5m",
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "tls_mode": "starttls",
      "from_name": "Truster",
      "from_address": "auth@example.com",
      "credentials_secret": "TRUSTER_SMTP_CREDENTIALS",
    },
    "turnstile": {
      "site_key": "replace-with-your-turnstile-site-key",
      "secret_name": "TRUSTER_TURNSTILE_SECRET",
    },
  },

  "static_policy": {
    "require_user_groups_from_policy": false,
    "default_redirect_uris": ["http://localhost:8000"],
    "clients": {
      "kubelogin": {},
    },
  },
}
