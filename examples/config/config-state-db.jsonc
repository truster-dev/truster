// SPDX-License-Identifier: Apache-2.0
{
  "$schema": "https://truster.dev/schema/v3/config.schema.json",
  "issuer_url": "http://localhost:8080",
  "http_listen_addr": "127.0.0.1:8080",
  "secrets": { "provider": "env", "signing_key_name": "TRUSTER_SIGNING_KEY" },
  "state_database": {
    "driver": "postgresql",
    "connection_string_secret": "TRUSTER_STATE_DB_URL",
    "migrations": {
      "connection_string_secret": "TRUSTER_STATE_MIGRATION_DB_URL",
    },
  },
  "user_login_connectors": {
    "google": {
      "type": "google",
      "display_name": "Google",
      "credentials_secret": "TRUSTER_GOOGLE_CREDENTIALS",
    },
  },
  "static_policy": {
    "default_redirect_uris": ["http://localhost:8000"],
    "clients": { "kubelogin-local": {} },
  },
}
